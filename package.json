{
  "name": "tessh-server",
  "version": "1.2.1",
  "description": "Self-hostable sync and key page server for the Tessh SSH app",
  "license": "Elastic-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tessh-server": "dist/main.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "node --disable-warning=ExperimentalWarning src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
